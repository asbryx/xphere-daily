# Konfigurasi lokal — JANGAN di-commit
# Copy file ini jadi .env lalu isi nilainya

# Folder berisi file session Telethon (acc01.session, acc02.session, ...)
SESSION_DIR=./sessions

# api_id & api_hash Telegram (gratis dari https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# (opsional) mapping akun + status onboarded — kalau tidak ada, bot scan folder sessions
STATE_FILE=./xphere_state.json

# (opsional) log hasil check-in
LOG_FILE=./xphere_checkin_log.jsonl

# jeda antar akun (detik)
DELAY_BETWEEN=3

# (opsional) override kalau mini app pindah backend
# SUPABASE_URL=https://ltodfynoaozgcaobwcgo.supabase.co
# SUPABASE_ANON_KEY=eyJ...
